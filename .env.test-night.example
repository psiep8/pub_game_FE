# ============================================================
#  PubGame — serata di prova con gli amici
#  Copia in `.env` prima di `npm run dev`.
# ============================================================

FE_PORT=4200
BE_PORT=8080

# 0.0.0.0 = TV e telefoni sulla stessa rete Wi-Fi.
HOST=0.0.0.0

# Regia: almeno 32 caratteri casuali. TV e admin non entrano senza.
CONTROL_SECRET=

# Origini esatte, separate da virgola. Aggiungi l'IP LAN del computer che
# proietta (lo stampa `npm run dev`) e, se usi il tunnel, l'URL HTTPS.
# Esempio: http://localhost:4200,http://192.168.1.10:4200,https://xxx.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# La banca domande è pre-generata: nessuna chiave AI necessaria.
# TMDB_API_KEY server solo per generare nuove foto, non per giocare.
