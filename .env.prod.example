# ============================================================
#  PubGame — produzione nel pub
#  Copia in `.env` sul server che proietta. Non versionare `.env`.
# ============================================================

FE_PORT=4200
BE_PORT=8080

# Il reverse proxy (Caddy/nginx) è l'unico esposto: il backend ascolta in locale.
HOST=127.0.0.1

# Regia: almeno 32 caratteri casuali, diverso da quello di prova.
CONTROL_SECRET=

# Un solo dominio serve TV, telefoni, API e WebSocket.
ALLOWED_ORIGINS=https://play.example.it

# URL pubblico usato per canzoni e foto locali.
MEDIA_BASE_URL=https://play.example.it

# Percorso del database H2 sul server (montato su disco persistente).
# DB_URL=jdbc:h2:file:/srv/pubgame/data/pubgame;DB_CLOSE_DELAY=-1

# Finestra di risposta e timeout heartbeat, in secondi.
ANSWER_WINDOW_SECONDS=300
HEARTBEAT_TIMEOUT_SECONDS=25
