{
  "name": "pub-game",
  "version": "3.1.1",
  "private": true,
  "description": "Monorepo PubGame: frontend Angular + backend Spring Boot",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.20.0"
  },
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs all",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:backend": "node scripts/dev.mjs backend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --workspace pubgame-fe",
    "build:test-night": "npm run build:test-night --workspace pubgame-fe",
    "build:prod": "npm run build:prod --workspace pubgame-fe",
    "build:backend": "node scripts/mvn.mjs -DskipTests package",
    "test": "npm run test:frontend",
    "test:frontend": "npm run test --workspace pubgame-fe",
    "test:backend": "node scripts/mvn.mjs test",
    "test:sim": "node --test scripts/sim/serata-contract.test.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:legacy-copy": "node scripts/legacy-quiz-copy.mjs",
    "audit:design": "impeccable detect apps/frontend/src",
    "audit:banche": "node scripts/audit-banche.mjs --write",
    "stress:ws": "node scripts/stress/ws-load.mjs",
    "stress:restart": "node scripts/stress/restart-check.mjs"
  },
  "devDependencies": {
    "@angular/service-worker": "^22.3.0",
    "impeccable": "^4.10.0",
    "playwright": "^1.65.1",
    "vitest": "^5.1.1"
  },
  "packageManager": "npm@11.20.0"
}
