{
  "name": "pub-game",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo PubGame: frontend Angular + backend Spring Boot",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs all",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:backend": "node scripts/dev.mjs backend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --workspace pubgame-fe",
    "build:backend": "node scripts/mvn.mjs -DskipTests package",
    "test": "npm run test:frontend",
    "test:frontend": "npm run test --workspace pubgame-fe",
    "test:backend": "node scripts/mvn.mjs test"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@11.6.2"
}
