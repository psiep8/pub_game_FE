# --- Dipendenze ---
node_modules/

# --- Build frontend (Angular) ---
dist/
out-tsc/
.angular/
coverage/
__screenshots__/

# --- Strumenti locali (JDK e ffmpeg scaricati senza admin) ---
.tools/

# --- Scratch locale delle verifiche (screenshot, note): non è codice ---
.basket-verify/

# --- Impeccable: cache e stato locale (PRODUCT.md e DESIGN.md restano versionati) ---
.impeccable/

# --- Audio grezzo: i file scelti a mano, non vanno versionati ---
apps/frontend/public/assets/audio/_src/
apps/frontend/public/assets/audio/**/*.part.m4a

# --- Build backend (Maven / Java) ---
target/
*.class
# Database H2 su file: sopravvive al riavvio, non va versionato.
apps/backend/data/

# --- Backup del database (serata) ---
backups/

# --- Env e segreti ---
scripts/sim/.state.json
.env
.env.*
!.env.example
!.env.*.example

# --- IDE / sistema ---
.idea/
.openidea/
*.iml
.history/
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Script Python di utilità
__pycache__/
*.pyc

# Media scaricati da generate_media.py (grandi: si copiano a mano)
apps/backend/src/main/resources/static/media/
apps/backend/src/main/resources/questions/media-it.json

# Testi del bonus «Canta la canzone»: protetti da diritto d'autore, restano
# locali. Nel repo c'è solo la struttura e un esempio con testi finti.
apps/backend/src/main/resources/questions/lyrics-bonus-it.json
apps/backend/src/main/resources/questions/bonus-scelte.json

# Stato token delle run di simulazione (mai versionare)
scripts/sim/.state*.json

# Dati delle run: CSV, JSON, log e report pesano ~13 MB e non sono codice.
# Restano su disco, entrano nel repo solo i generatori.
scripts/sim/reports/*
!scripts/sim/reports/*.mjs

# Scratch del test audio (non deve entrare nel repo)
tmp-audio-test/
