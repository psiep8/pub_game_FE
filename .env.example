[TEMPLATE]
# ============================================================
#  PubGame — configurazione locale
#  Copia in `.env` e compila le chiavi opzionali.
#  `.env` è ignorato da git: nessuna chiave finisce nel repository.
# ============================================================

# --- Rete (letta da scripts/dev.mjs, proxy.conf.mjs e start-tunnel.*) ---
FE_PORT=4200
BE_PORT=8080

# Interfaccia di ascolto: 0.0.0.0 = raggiungibile dal telefono in LAN.
HOST=0.0.0.0

# --- Domande AI (Groq: https://console.groq.com/keys) ---
# Senza chiave il backend usa le domande di riserva locali, senza attese.
GROQ_API_KEY=
# Modello Groq. openai/gpt-oss-120b è il sostituto ufficiale di
# llama-3.3-70b-versatile, spento da Groq il 16/08/2026.
GROQ_MODEL=openai/gpt-oss-120b

# --- Immagini celebrità (TMDB: https://www.themoviedb.org/settings/api) ---
# Senza chiave "Indovina chi" mostra la domanda senza foto.
TMDB_API_KEY=

# --- Musica ---
# Nessuna chiave: il backend usa l'iTunes Search API pubblica (anteprime 30s).
