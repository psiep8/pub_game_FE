{
  "name": "pubgame-fe",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:all": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:test-night": "ng build --configuration test-night",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "serve:test-night": "ng serve --configuration test-night",
    "serve:prod": "ng serve --configuration production",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/pwa": "^22.2.5",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@stomp/stompjs": "^7.5.0",
    "matter-js": "^0.20.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/matter-js": "^0.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/sockjs-client": "^1.5.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3"
  }
}
